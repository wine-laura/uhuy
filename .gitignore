# Node
node_modules/
dist/
.env

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# App specific
backend/uploads/
backend/outputs/

# Mode produksi — JANGAN di-commit.
# cameras.json memuat URL RTSP lengkap dengan user & password kamera.
# kejadian.jsonl memuat log kejadian nyata dan tunduk pada kebijakan retensi,
# jadi tidak boleh ikut tersalin ke riwayat git yang permanen.
backend/data/cameras.json
backend/data/kejadian.jsonl
backend/data/*.tmp
!backend/data/cameras.example.json

# OS files
.DS_Store
Thumbs.db

# Model weights (file root diabaikan, model backend disertakan)
*.pt
!backend/models/*.pt

# File root yang bukan bagian project
/inference.py
/train_fall.py
/kepala_interaksi.py
/test_video.mp4


# Mode produksi — JANGAN di-commit.
# cameras.json memuat URL RTSP lengkap dengan user & password kamera.
# kejadian.jsonl memuat log kejadian nyata dan tunduk pada kebijakan retensi.
# videos/ berisi rekaman uji yang bisa memuat orang nyata.
backend/data/cameras.json
backend/data/kejadian.jsonl
backend/data/videos/
backend/data/*.tmp
# seragam.json memuat sidik seragam milik toko tertentu — konfigurasi lokal,
# bukan bagian aplikasi. (Isinya histogram warna, bukan gambar.)
backend/data/seragam.json
!backend/data/cameras.example.json
